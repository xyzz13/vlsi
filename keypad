LIBRARY IEEE;
USE IEEE.STD_LOGIC_1164.ALL;
USE IEEE.NUMERIC_STD.ALL;

----------------------------------------------------------------------------------
-- ENTITY DECLARATION
----------------------------------------------------------------------------------
ENTITY keypad IS
    PORT (
        clk      : IN  STD_LOGIC;                    -- System clock
        rst      : IN  STD_LOGIC;                    -- Asynchronous reset
        Row      : OUT STD_LOGIC_VECTOR(3 DOWNTO 0); -- Keypad row outputs (active low)
        Col      : IN  STD_LOGIC_VECTOR(3 DOWNTO 0); -- Keypad column inputs (active low)
        Key_code : OUT STD_LOGIC_VECTOR(3 DOWNTO 0); -- 4-bit code of the pressed key
        Key_valid: OUT STD_LOGIC                    -- Signal to indicate a valid key press
    );
END keypad;

----------------------------------------------------------------------------------
-- ARCHITECTURE DEFINITION
----------------------------------------------------------------------------------
ARCHITECTURE Behavioral OF keypad IS

    -- State machine signal. The state determines which row to scan.
    SIGNAL state : INTEGER RANGE 0 TO 3 := 0;

BEGIN

    PROCESS (clk, rst)
    BEGIN
        -- Asynchronous reset logic
        IF rst = '1' THEN
            Row       <= "1111";          -- Disable all rows (set high)
            Key_code  <= (OTHERS => '0'); -- Reset key code
            Key_valid <= '0';             -- Invalidate key
            state     <= 0;               -- Reset to the first state

        -- Logic executes on the rising edge of the clock
        ELSIF rising_edge(clk) THEN

            -- Default state for Key_valid per clock cycle (clears unless a key is pressed)
            Key_valid <= '0';

            -- State machine for continuously scanning rows
            CASE state IS

                -- STATE 0: Scan Row 0
                WHEN 0 =>
                    Row <= "1110"; -- Enable Row 0 (set low)
                    IF    Col(0) = '0' THEN Key_code <= "0000"; Key_valid <= '1';
                    ELSIF Col(1) = '0' THEN Key_code <= "0001"; Key_valid <= '1';
                    ELSIF Col(2) = '0' THEN Key_code <= "0010"; Key_valid <= '1';
                    ELSIF Col(3) = '0' THEN Key_code <= "0011"; Key_valid <= '1';
                    END IF;
                    state <= 1; -- Unconditionally move to next state

                -- STATE 1: Scan Row 1
                WHEN 1 =>
                    Row <= "1101"; -- Enable Row 1
                    IF    Col(0) = '0' THEN Key_code <= "0100"; Key_valid <= '1';
                    ELSIF Col(1) = '0' THEN Key_code <= "0101"; Key_valid <= '1';
                    ELSIF Col(2) = '0' THEN Key_code <= "0110"; Key_valid <= '1';
                    ELSIF Col(3) = '0' THEN Key_code <= "0111"; Key_valid <= '1';
                    END IF;
                    state <= 2;

                -- STATE 2: Scan Row 2
                WHEN 2 =>
                    Row <= "1011"; -- Enable Row 2
                    IF    Col(0) = '0' THEN Key_code <= "1000"; Key_valid <= '1';
                    ELSIF Col(1) = '0' THEN Key_code <= "1001"; Key_valid <= '1';
                    ELSIF Col(2) = '0' THEN Key_code <= "1010"; Key_valid <= '1';
                    ELSIF Col(3) = '0' THEN Key_code <= "1011"; Key_valid <= '1';
                    END IF;
                    state <= 3;

                -- STATE 3: Scan Row 3
                WHEN 3 =>
                    Row <= "0111"; -- Enable Row 3
                    IF    Col(0) = '0' THEN Key_code <= "1100"; Key_valid <= '1';
                    ELSIF Col(1) = '0' THEN Key_code <= "1101"; Key_valid <= '1';
                    ELSIF Col(2) = '0' THEN Key_code <= "1110"; Key_valid <= '1';
                    ELSIF Col(3) = '0' THEN Key_code <= "1111"; Key_valid <= '1';
                    END IF;
                    state <= 0;

                -- Default case for safety
                WHEN OTHERS =>
                    state <= 0;

            END CASE;
        END IF;
    END PROCESS;

END Behavioral;
